# Puerto del servidor (el frontend apunta a http://localhost:8080)
PORT=8080

# Neon: copiar las URLs desde Connect o usar las variables de la raíz generadas por neon deploy.
# Dejar vacías para trabajar con SQLite local.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# OBLIGATORIO en producción: cadena larga y aleatoria (mínimo 16 caracteres).
# Generar una: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Ruta del archivo de base de datos SQLite
DB_PATH=./data/inventario.db

# Orígenes permitidos por CORS, separados por coma. Ejemplo: http://localhost:5173,https://mi-app.vercel.app
CORS_ORIGIN=http://localhost:5173

# Contraseña inicial de los usuarios de ejemplo (superadmin, admin, encargado). Cámbiala.
SEED_PASSWORD=
